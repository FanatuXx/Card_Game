      hasAce bool","comment":null,"color":{"r":0.0,"g":0.0,"b":0.0,"a":1.0},"guid":"7aa2aeb4-da07-412e-9b38-0d6f8ab10f1e","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-2039.0,"yMin":-1722.0,"xMax":-1158.0,"yMax":-1143.0},"label":"Check
      if there is an Ace in the AI''s hand - WRONG","comment":null,"color":{"r":0.0,"g":0.0,"b":0.0,"a":1.0},"guid":"fd7f314e-8643-450a-94ba-6874bc2ca21f","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-2785.0,"yMin":-1125.2,"xMax":-311.0,"yMax":-439.0572},"label":"Check
      if there is an Ace in the AI''s hand - GOOD","comment":null,"color":{"r":0.0,"g":0.0,"b":0.0,"a":1.0},"guid":"55a02460-112f-42dd-93a6-b98f2ecfe4b7","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-2014.0,"yMin":-1547.0,"xMax":-1660.0,"yMax":-1428.0},"title":"List
      contains Item","body":"\nThe node cannot be used in this situation because
      :\n\n- It checks for EXACT GAMEOBJECT references\n- It does NOT check for properties
      \n","colorTheme":"Classic","guid":"6ddb391d-b94b-4a06-b872-d39fa8ee1b35","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-2038.0,"yMin":-855.0,"xMax":-1324.0,"yMax":-549.0},"title":"Correct
      way to check if my AI has card in hand AND add them to possibleCards list","body":"\n1)
      Go trough my Cards In Hand (Game Objects) with For Each loop\n\n2) Get the
      Card Display component (from my Game Objects, I make a reference to the Card
      Display component which contains my Scriptable Objects)\n\n3) Get the Card
      Data component (the Card Data component is what it makes me possible to make
      a reference to my Scripting Objects from my GameObjects)\n\n4) Get Card Name
      (refers to my Scriptable Objects)\n-> This one is tricky : My Card Data component
      contains which specific Card is attached to it\nSo I can get my cards data
      (value, name, color, ...) from my Card Display component \n\n5) Connect my
      Get Card Data component to the Add Item node because it''s the direct reference
      from my Scriptable Objects\n \n","colorTheme":"Classic","guid":"ce9ecae0-c65d-4a24-af16-d82853201a98","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-2698.0,"yMin":-875.0,"xMax":-2453.0,"yMax":-778.0},"title":"Clear
      list ","body":"\nMake sure that there are NOT multiple time the same card stored
      in possibleCards list\n","colorTheme":"Classic","guid":"7f6cb8d4-9c4a-42bf-9a9a-84a6a2029bdc","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}},"defaultValues":{},"position":{"x":834.0,"y":271.0},"guid":"d6acf602-e108-42dd-b5ee-0d2388fa72eb","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"181"},{"type":"System.Int32","value":{"$content":1,"$type":"System.Int32"},"defaultValues":{},"position":{"x":611.0,"y":-602.0},"guid":"3ba6dc71-95eb-4a30-8dc2-e12749dfbf47","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"544"},{"chainable":false,"parameterNames":["name"],"member":{"name":"Find","parameterTypes":["System.String"],"targetType":"UnityEngine.GameObject","targetTypeName":"UnityEngine.GameObject","$version":"A"},"defaultValues":{"%name":{"$content":"PlayerAI1","$type":"System.String"}},"position":{"x":421.0,"y":743.0},"guid":"099904fa-406c-4c42-b5ed-da8ded64f70b","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"546"},{"chainable":false,"parameterNames":["name"],"member":{"name":"Find","parameterTypes":["System.String"],"targetType":"UnityEngine.GameObject","targetTypeName":"UnityEngine.GameObject","$version":"A"},"defaultValues":{"%name":{"$content":"PlayerHuman","$type":"System.String"}},"position":{"x":-37.0,"y":744.0},"guid":"cc42bff5-edd5-4d98-92d7-20e7701ece54","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"550"},{"defaultValues":{},"position":{"x":583.0,"y":271.0},"guid":"292374a0-066a-4322-ba68-cf3f455d1f68","$version":"A","$type":"Unity.VisualScripting.If","$id":"554"},{"type":"System.Int32","value":{"$content":0,"$type":"System.Int32"},"defaultValues":{},"position":{"x":822.0,"y":-210.0},"guid":"c2587110-a109-47c2-bbe0-79e2dfd5f26c","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"556"},{"numeric":false,"defaultValues":{},"position":{"x":-16.0,"y":212.0},"guid":"f3dec0d0-2ef4-46b7-bf7d-168b03304774","$version":"A","$type":"Unity.VisualScripting.Equal","$id":"55