tion"},{"position":{"xMin":-1814.0,"yMin":394.0,"xMax":-1100.0,"yMax":700.0},"title":"Correct
      way to check if my AI has card in hand AND add them to possibleCards list","body":"\n1)
      Go trough my Cards In Hand (Game Objects) with For Each loop\n\n2) Get the
      Card Display component (from my Game Objects, I make a reference to the Card
      Display component which contains my Scriptable Objects)\n\n3) Get the Card
      Data component (the Card Data component is what it makes me possible to make
      a reference to my Scripting Objects from my GameObjects)\n\n4) Get Card Name
      (refers to my Scriptable Objects)\n-> This one is tricky : My Card Data component
      contains which specific Card is attached to it\nSo I can get my cards data
      (value, name, color, ...) from my Card Display component \n\n5) Connect my
      Get Card Data component to the Add Item node because it''s the direct reference
      from my Scriptable Objects\n \n","colorTheme":"Classic","guid":"29615cf0-4d2c-4278-8bbe-fafd63685f20","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}},"defaultValues":{},"position":{"x":2981.0,"y":-391.0},"guid":"5a61090f-7c7e-464e-b3ec-3b95efcc3a7d","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"1005"},{"chainable":false,"parameterNames":["message"],"member":{"name":"Log","parameterTypes":["System.Object"],"targetType":"UnityEngine.Debug","targetTypeName":"UnityEngine.Debug","$version":"A"},"defaultValues":{},"position":{"x":3106.0,"y":90.0},"guid":"55d36867-7626-41e7-a9f5-9d1e89580c7e","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"1093"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"possibleCards","$type":"System.String"}},"position":{"x":2753.0,"y":-440.0},"guid":"8fa8580d-e20b-4712-bcdf-b61628581de5","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"1097"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"isFirstPlayer","$type":"System.String"}},"position":{"x":2550.0,"y":307.0},"guid":"44b6e288-e19c-4f14-8aa0-dd0d6c8b5f2e","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"1099"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"aiHand","$type":"System.String"}},"position":{"x":11889.0,"y":-722.0},"guid":"b84b56ed-3e41-40bb-8771-55b5318b3679","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"1101"},{"argumentCount":0,"defaultValues":{"name":{"$content":"NextTurn","$type":"System.String"},"target":null},"position":{"x":14300.0,"y":-47.0},"guid":"b8a94545-7de6-423f-9645-056d52f5467a","$version":"A","$type":"Unity.VisualScripting.TriggerCustomEvent","$id":"1103"},{"nest":{"source":"Embed","macro":null,"embed":{"variables":{"Kind":"Flow","collection":{"$content":[{"name":"cardToPlay","value":null,"typeHandle":{"Identification":"UnityEngine.GameObject,
