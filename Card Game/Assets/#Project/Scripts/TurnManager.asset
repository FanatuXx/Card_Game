      hasAce bool","comment":null,"color":{"r":0.0,"g":0.0,"b":0.0,"a":1.0},"guid":"7aa2aeb4-da07-412e-9b38-0d6f8ab10f1e","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-2039.0,"yMin":-1722.0,"xMax":-1158.0,"yMax":-1143.0},"label":"Check
      if there is an Ace in the AI''s hand - WRONG","comment":null,"color":{"r":0.0,"g":0.0,"b":0.0,"a":1.0},"guid":"fd7f314e-8643-450a-94ba-6874bc2ca21f","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-2785.0,"yMin":-1110.0,"xMax":-311.0,"yMax":-489.0},"label":"Check
      if there is an Ace in the AI''s hand - GOOD","comment":null,"color":{"r":0.0,"g":0.0,"b":0.0,"a":1.0},"guid":"55a02460-112f-42dd-93a6-b98f2ecfe4b7","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-2014.0,"yMin":-1547.0,"xMax":-1660.0,"yMax":-1428.0},"title":"List
      contains Item","body":"\nThe node cannot be used in this situation because
      :\n\n- It checks for EXACT GAMEOBJECT references\n- It does NOT check for properties
      \n","colorTheme":"Classic","guid":"6ddb391d-b94b-4a06-b872-d39fa8ee1b35","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-2038.0,"yMin":-855.0,"xMax":-1324.0,"yMax":-549.0},"title":"Correct
      way to check if my AI has card in hand AND add them to possibleCards list","body":"\n1)
      Go trough my Cards In Hand (Game Objects) with For Each loop\n\n2) Get the
      Card Display component (from my Game Objects, I make a reference to the Card
      Display component which contains my Scriptable Objects)\n\n3) Get the Card
      Data component (the Card Data component is what it makes me possible to make
      a reference to my Scripting Objects from my GameObjects)\n\n4) Get Card Name
      (refers to my Scriptable Objects)\n-> This one is tricky : My Card Data component
      contains which specific Card is attached to it\nSo I can get my cards data
      (value, name, color, ...) from my Card Display component \n\n5) Connect my
      Get Card Data component to the Add Item node because it''s the direct reference
      from my Scriptable Objects\n \n","colorTheme":"Classic","guid":"ce9ecae0-c65d-4a24-af16-d82853201a98","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}},"defaultValues":{},"position":{"x":834.0,"y":271.0},"guid":"d6acf602-e108-42dd-b5ee-0d2388fa72eb","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"20"},{"coroutine":false,"defaultValues":{},"position":{"x":-204.0,"y":60.0},"guid":"073df10a-97a9-45be-aee1-84c3a8cd354c","$version":"A","$type":"Unity.VisualScripting.Update","$id":"373"},{"chainable":false,"parameterNames":["name"],"member":{"name":"Find","parameterTypes":["System.String"],"targetType":"UnityEngine.GameObject","targetTypeName":"UnityEngine.GameObject","$version":"A"},"defaultValues":{"%name":{"$content":"PlayerAI2","$type":"System.String"}},"position":{"x":881.0,"y":740.0},"guid":"2e35bac8-a6fd-4177-adf2-474e0021a6f1","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"375"},{"argumentCount":0,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"NextTurn","$type":"System.String"}},"position":{"x":-148.0,"y":-683.0},"guid":"9826034e-fcb6-42aa-b1b2-d16e6e15ccc1","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"379"},{"defaultValues":{},"position":{"x":150.0,"y":60.0},"guid":"9096a19c-d5f3-434f-b1e7-43464bbc6090","$version":"A","$type":"Unity.VisualScripting.If","$id":"381"},{"specifyFallback":false,"kind":"Object","defaultValues":{"name":{"$content":"CurrentPlayer","$type":"System.String"},"object":null},"position":{"x":-262.0,"y":191.0},"guid":"f1949f03-01a2-4605-92f4-fca1bf8a47f4","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"383"},{"specifyFallback":false,"kind":"Object","defaultValues":{"name":{"$content":"CurrentPlayer","$type":"System.String"},"object":null},"position":{"x":277.0,"y":-411.0},"guid":"98b461c8-9612-46c1-8d48-f0166027dc72","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"385"},{"nest":{"source":"Embed","macro":null,"e