      DO !","body":"\nPLAYER SPECIFIC :\n\n- SET CARDS BY COLOR AFTER DEALING CARDS\n-
      SET CARDS COUNT BY COLOR AFTER DEALING CARDS\n\nSHARED INBETWEEN PLAYERS :\n\n-
      When a card is played this round, ADD IT TO PLAYEDCARDSTHISROUND\n- When a
      card is played, ADD IT TO ALLPLAYEDCARDS\n- When a card is played, ADD IT TO
      CURRENTTRICKPLAYERCARDS with reference to the PLAYER\n- When a player is out
      of cards from a specific color, ADD A REFERENCE TO THIS COLOR TO PLAYERSWHOHAVECUT\n-
      When a card is played, REMOVE ITS COLOR FROM UNPLAYEDCOLOR\n- When a card is
      played, DECREMENT ITS COLOR''S VALUE FROM STRONGESTREMAININGCARDBYCOLOR\n\n\nRESET
      LEADING COLOR : how ?\n\n\n\n","colorTheme":"Classic","guid":"807bba9d-73c0-4f2d-a558-d37316c1ad90","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}},"defaultValues":{},"position":{"x":833.0,"y":269.0},"guid":"d6acf602-e108-42dd-b5ee-0d2388fa72eb","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"113"},{"chainable":false,"parameterNames":["name"],"member":{"name":"Find","parameterTypes":["System.String"],"targetType":"UnityEngine.GameObject","targetTypeName":"UnityEngine.GameObject","$version":"A"},"defaultValues":{"%name":{"$content":"PlayerAI1","$type":"System.String"}},"position":{"x":421.0,"y":743.0},"guid":"099904fa-406c-4c42-b5ed-da8ded64f70b","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"1838"},{"type":"System.Int32","value":{"$content":1,"$type":"System.Int32"},"defaultValues":{},"position":{"x":-494.0,"y":-241.0},"guid":"22c96f5f-164f-4e96-9530-0a5c1c475a5a","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"1842"},{"kind":"Object","defaultValues":{"name":{"$content":"PlayerHuman","$type":"System.String"},"object":null},"position":{"x":218.0,"y":739.0},"guid":"d22077af-ae93-43a9-866d-dc71abd15801","$version":"A","$type":"Unity.VisualScripting.SetVariable","$id":"1844"},{"nest":{"source":"Embed","macro":null,"embed":{"variables":{"Kind":"Flow","collection":{"$content":[],"$version":"A"},"$version":"A"},"controlInputDefinitions":[{"key":"In","label":"In","summary":null,"hideLabel":false}],"controlOutputDefinitions":[{"key":"Out","label":"Out","summary":null,"hideLabel":false}],"valueInputDefinitions":[],"valueOutputDefinitions":[],"title":"PlayerHuman","summary":null,"pan":{"x":-416.548,"y":-13.0},"zoom":1.0,"elements":[{"defaultValues":{},"position":{"x":-858.0,"y":-21.0},"guid":"076136f3-de80-432a-8a55-ca3fbb8c7aa4","$version":"A","$type":"Unity.VisualScripting.GraphInput","$id":"1858"},{"defaultValues":{},"position":{"x":-281.0,"y":-22.0},"guid":"6b1359c2-142d-4d6b-b986-9082ab324ce7","$vers