      DO !","body":"\nPLAYER SPECIFIC :\n\n- SET CARDS BY COLOR AFTER DEALING CARDS\n-
      SET CARDS COUNT BY COLOR AFTER DEALING CARDS\n\nSHARED INBETWEEN PLAYERS :\n\n-
      When a card is played this round, ADD IT TO PLAYEDCARDSTHISROUND\n- When a
      card is played, ADD IT TO ALLPLAYEDCARDS\n- When a card is played, ADD IT TO
      CURRENTTRICKPLAYERCARDS with reference to the PLAYER\n- When a player is out
      of cards from a specific color, ADD A REFERENCE TO THIS COLOR TO PLAYERSWHOHAVECUT\n-
      When a card is played, REMOVE ITS COLOR FROM UNPLAYEDCOLOR\n- When a card is
      played, DECREMENT ITS COLOR''S VALUE FROM STRONGESTREMAININGCARDBYCOLOR\n\n\n\n","colorTheme":"Classic","guid":"807bba9d-73c0-4f2d-a558-d37316c1ad90","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}},"defaultValues":{},"position":{"x":833.0,"y":269.0},"guid":"d6acf602-e108-42dd-b5ee-0d2388fa72eb","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"251"},{"type":"System.Int32","value":{"$content":1,"$type":"System.Int32"},"defaultValues":{},"position":{"x":611.0,"y":-602.0},"guid":"3ba6dc71-95eb-4a30-8dc2-e12749dfbf47","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"1705"},{"chainable":false,"parameterNames":["name"],"member":{"name":"Find","parameterTypes":["System.String"],"targetType":"UnityEngine.GameObject","targetTypeName":"UnityEngine.GameObject","$version":"A"},"defaultValues":{"%name":{"$content":"PlayerAI1","$type":"System.String"}},"position":{"x":421.0,"y":743.0},"guid":"099904fa-406c-4c42-b5ed-da8ded64f70b","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"1707"},{"type":"System.Int32","value":{"$content":2,"$type":"System.Int32"},"defaultValues":{},"position":{"x":820.0,"y":-394.0},"guid":"389bdd21-8e53-4265-8d80-54cf56560751","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"1711"},{"defaultValues":{},"position":{"x":583.0,"y":271.0},"guid":"292374a0-066a-4322-ba68-cf3f455d1f68","$version":"A","$type":"Unity.VisualScripting.If","$id":"1713"},{"specifyFallback":false,"kind":"Object","defaultValues":{"name":{"$content":"CurrentPlayer","$type":"System.String"},"object":null},"position":{"x":-262.0,"y":191.0},"guid":"f1949f03-01a2-4605-92f4-fca1bf8a47f4","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"1715"},{"numeric":false,"defaultValues":{},"position":{"x":-16.0,"y":212.0},"guid":"f3dec0d0-2ef4-46b7-bf7d-168b03304774","$version":"A","$type":"Unity.VisualScripting.Equal","$id":"1717"},{"chainable":false,"parameterNames":["name"],"member":{"name":"Find","paramete