      DO !","body":"\nPLAYER SPECIFIC :\n\n- SET CARDS BY COLOR AFTER DEALING CARDS\n-
      SET CARDS COUNT BY COLOR AFTER DEALING CARDS\n\nSHARED INBETWEEN PLAYERS :\n\n-
      When a card is played this round, ADD IT TO PLAYEDCARDSTHISROUND\n- When a
      card is played, ADD IT TO ALLPLAYEDCARDS\n- When a card is played, ADD IT TO
      CURRENTTRICKPLAYERCARDS with reference to the PLAYER\n- When a player is out
      of cards from a specific color, ADD A REFERENCE TO THIS COLOR TO PLAYERSWHOHAVECUT\n-
      When a card is played, REMOVE ITS COLOR FROM UNPLAYEDCOLOR\n- When a card is
      played, DECREMENT ITS COLOR''S VALUE FROM STRONGESTREMAININGCARDBYCOLOR\n\n\n\n","colorTheme":"Classic","guid":"807bba9d-73c0-4f2d-a558-d37316c1ad90","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}},"defaultValues":{},"position":{"x":833.0,"y":269.0},"guid":"d6acf602-e108-42dd-b5ee-0d2388fa72eb","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"86"},{"numeric":false,"defaultValues":{},"position":{"x":-20.0,"y":293.0},"guid":"f3dec0d0-2ef4-46b7-bf7d-168b03304774","$version":"A","$type":"Unity.VisualScripting.Equal","$id":"1589"},{"specifyFallback":false,"kind":"Object","defaultValues":{"name":{"$content":"CurrentPlayer","$type":"System.String"},"object":null},"position":{"x":-1006.0,"y":-502.0},"guid":"db0f7fb7-080f-4686-9f6a-1b7a802b0178","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"1591"},{"chainable":false,"parameterNames":["name"],"member":{"name":"Find","parameterTypes":["System.String"],"targetType":"UnityEngine.GameObject","targetTypeName":"UnityEngine.GameObject","$version":"A"},"defaultValues":{"%name":{"$content":"PlayerHuman","$type":"System.String"}},"position":{"x":-37.0,"y":744.0},"guid":"cc42bff5-edd5-4d98-92d7-20e7701ece54","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"1593"},{"nest":{"source":"Embed","macro":null,"embed":{"variables":{"Kind":"Flow","collection":{"$content":[],"$version":"A"},"$version":"A"},"controlInputDefinitions":[{"key":"In","label":"In","summary":null,"hideLabel":false}],"controlOutputDefinitions":[{"key":"Out","label":"Out","summary":null,"hideLabel":false}],"valueInputDefinitions":[],"valueOutputDefinitions":[],"title":"PlayerHuman","summary":null,"pan":{"x":-416.548,"y":-13.0},"zoom":1.0,"elements":[{"defaultValues":{},"position":{"x":-858.0,"y":-21.0},"guid":"076136f3-de80-432a-8a55-ca3fbb8c7aa4","$version":"A","$type":"Unity.VisualScripting.GraphInput","$id":"1609"},{"defaultValues":{},"position":{"x":-281.0,"y":-22.0},"guid":"6b1359c2-142d-4d6b-b