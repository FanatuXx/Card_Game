ourceUnit":{"$ref":"1071"},"sourceKey":"value","destinationUnit":{"$ref":"1052"},"destinationKey":"b","guid":"28688389-95e8-4a91-92be-d662fa3b6954","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"1037"},"sourceKey":"equal","destinationUnit":{"$ref":"1065"},"destinationKey":"a","guid":"9fc65ac9-9cd9-457a-888a-0dfa9012dcad","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"1078"},"sourceKey":"out","destinationUnit":{"$ref":"1074"},"destinationKey":"in","guid":"51af8b3d-e398-41d7-9c70-fe9aa758d8a7","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"1050"},"sourceKey":"currentItem","destinationUnit":{"$ref":"1067"},"destinationKey":"item","guid":"761d0875-7ed8-4c02-bc0b-2da107dd4adb","$type":"Unity.VisualScripting.ValueConnection"},{"position":{"xMin":-1814.0,"yMin":394.0,"xMax":-1100.0,"yMax":700.0},"title":"Correct
      way to check if my AI has card in hand AND add them to possibleCards list","body":"\n1)
      Go trough my Cards In Hand (Game Objects) with For Each loop\n\n2) Get the
      Card Display component (from my Game Objects, I make a reference to the Card
      Display component which contains my Scriptable Objects)\n\n3) Get the Card
      Data component (the Card Data component is what it makes me possible to make
      a reference to my Scripting Objects from my GameObjects)\n\n4) Get Card Name
      (refers to my Scriptable Objects)\n-> This one is tricky : My Card Data component
      contains which specific Card is attached to it\nSo I can get my cards data
      (value, name, color, ...) from my Card Display component \n\n5) Connect my
      Get Card Data component to the Add Item node because it''s the direct reference
      from my Scriptable Objects\n \n","colorTheme":"Classic","guid":"29615cf0-4d2c-4278-8bbe-fafd63685f20","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}},"defaultValues":{},"position":{"x":2981.0,"y":-826.0},"guid":"5a61090f-7c7e-464e-b3ec-3b95efcc3a7d","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"1021"},{"type":"System.Int32","value":{"$content":13,"$type":"System.Int32"},"defaultValues":{},"position":{"x":-543.0,"y":236.0},"guid":"5d3d0136-5a5b-4e04-b9fb-d4799dbc01fa","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"1115"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"possibleCards","$type":"System.String"}},"position":{"x":5037.0,"y":-542.0},"guid":"3d2550ac-aff8-491f-8e69-8224159918a9","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"1117"},{"nest":{"source":"Embed","macro":null,"embed":{"variables":{"Kind":"Flow","collection":{"$content":[{"name":"cardToPlay","value":null,"typeHandle":{"Identification":"UnityEngine.GameObject,
