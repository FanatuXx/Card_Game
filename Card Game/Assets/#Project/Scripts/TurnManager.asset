      DO !","body":"\nPLAYER SPECIFIC :\n\n- SET CARDS BY COLOR AFTER DEALING CARDS\n-
      SET CARDS COUNT BY COLOR AFTER DEALING CARDS\n\nSHARED INBETWEEN PLAYERS :\n\n-
      When a card is played this round, ADD IT TO PLAYEDCARDSTHISROUND\n- When a
      card is played, ADD IT TO ALLPLAYEDCARDS\n- When a card is played, ADD IT TO
      CURRENTTRICKPLAYERCARDS with reference to the PLAYER\n- When a player is out
      of cards from a specific color, ADD A REFERENCE TO THIS COLOR TO PLAYERSWHOHAVECUT\n-
      When a card is played, REMOVE ITS COLOR FROM UNPLAYEDCOLOR\n- When a card is
      played, DECREMENT ITS COLOR''S VALUE FROM STRONGESTREMAININGCARDBYCOLOR\n\n\nRESET
      LEADING COLOR : how ?\n\n\n\n","colorTheme":"Classic","guid":"807bba9d-73c0-4f2d-a558-d37316c1ad90","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}},"defaultValues":{},"position":{"x":834.0,"y":416.0},"guid":"9a9722d5-4e09-4a50-8e0d-75dd39cc9aac","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"4114"},{"chainable":false,"member":{"name":"cardValue","parameterTypes":null,"targetType":"TarotProject.Card","targetTypeName":"TarotProject.Card","$version":"A"},"defaultValues":{"target":null,"input":{"$content":0,"$type":"System.Int32"}},"position":{"x":4274.0,"y":734.0},"guid":"4ed8b53c-dbb8-46ae-9600-0f5696f8a374","$version":"A","$type":"Unity.VisualScripting.SetMember","$id":"7719"},{"member":{"name":"cardsInHand","parameterTypes":null,"targetType":"HandManager","targetTypeName":"HandManager","$version":"A"},"defaultValues":{"target":null},"position":{"x":2519.0,"y":788.0},"guid":"d5267a43-9928-4848-9240-e46e8ffcc06b","$version":"A","$type":"Unity.VisualScripting.GetMember","$id":"7722"},{"specifyFallback":false,"kind":"Scene","defaultValues":{"name":{"$content":"strongestRemainingCardByColor","$type":"System.String"}},"position":{"x":4468.0,"y":698.0},"guid":"b187758c-322e-4c58-a4be-2161de7c3872","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"7725"},{"numeric":false,"defaultValues":{},"position":{"x":456.0,"y":-344.0},"guid":"7622471f-3473-458a-9ca7-5115cd9db707","$version":"A","$type":"Unity.VisualScripting.Equal","$id":"7727"},{"SnapToGrid":false,"defaultValues":{},"position":{"x":1652.0,"y":667.0},"guid":"648a31eb-62c2-4426-a82b-e89d07759ded","$version":"A","$type":"Unity.VisualScripting.Community.FlowReroute","$id":"7729"},{"defaultValues":{},"position":{"x":4078.0,"y":734.0},"guid":"477be425-645e-4593-b319-e5bfb58a1e70","$version":"A","$type":"Unity.VisualScripting.If","$id":"7731"},{"inputCount":2,"defaultValues":{"1":{"$content":13.0,"$type":"System.Single"}},"position":{"x":3525.0,"y":1088.0},"guid":"6c30c