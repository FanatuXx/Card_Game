      replace by object variable","comment":null,"color":{"r":0.0,"g":0.0,"b":0.0,"a":1.0},"guid":"d9b2f2b1-1c7b-4157-b98c-1cff5f3a0df9","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":666.0,"yMin":-1122.0,"xMax":1070.0,"yMax":-557.0},"label":"Set
      hasAce bool","comment":null,"color":{"r":0.0,"g":0.0,"b":0.0,"a":1.0},"guid":"7aa2aeb4-da07-412e-9b38-0d6f8ab10f1e","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-2039.0,"yMin":-1722.0,"xMax":-1158.0,"yMax":-1143.0},"label":"Check
      if there is an Ace in the AI''s hand - WRONG","comment":null,"color":{"r":0.0,"g":0.0,"b":0.0,"a":1.0},"guid":"fd7f314e-8643-450a-94ba-6874bc2ca21f","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-2785.0,"yMin":-1125.2,"xMax":-311.0,"yMax":-439.0572},"label":"Check
      if there is an Ace in the AI''s hand - GOOD","comment":null,"color":{"r":0.0,"g":0.0,"b":0.0,"a":1.0},"guid":"55a02460-112f-42dd-93a6-b98f2ecfe4b7","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":5475.0,"yMin":-2212.0,"xMax":5855.0,"yMax":-2009.0},"label":"Remove
      card from possibleCards if someone has cut","comment":null,"color":{"r":0.0,"g":0.0,"b":0.0,"a":1.0},"guid":"5e56dab7-7e1a-4138-83a4-5548c24871db","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":5862.0,"yMin":-1426.0,"xMax":7286.0,"yMax":-975.0},"label":"Check
      if ScriptableObjects stored in possibleCards match GameObjects from aiHand","comment":null,"color":{"r":0.0,"g":0.0,"b":0.0,"a":1.0},"guid":"d1c5b4e5-c391-4acd-8845-116334b1cf88","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":1495.0,"yMin":-571.0,"xMax":4495.0,"yMax":92.0},"label":"Check
      if IA has the strongest card among played colors","comment":null,"color":{"r":0.0,"g":0.0,"b":0.0,"a":1.0},"guid":"86b86b9f-c082-4b9d-84d7-867c0f24c74c","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":6580.667,"yMin":-2508.333,"xMax":9354.0,"yMax":-1720.667},"label":"Check
      if AI has more cards in one specific color and add cards from this color to
      possibleCards","comment":null,"color":{"r":0.0,"g":0.0,"b":0.0,"a":1.0},"guid":"d957b728-1ad7-44b8-b2b8-9c49c977d56c","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-2014.0,"yMin":-1547.0,"xMax":-1660.0,"yMax":-1428.0},"title":"List
      contains Item","body":"\nThe node cannot be used in this situation because
      :\n\n- It checks for EXACT GAMEOBJECT references\n- It does NOT check for properties
      \n","colorTheme":"Classic","guid":"6ddb391d-b94b-4a06-b872-d39fa8ee1b35","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-2038.0,"yMin":-855.0,"xMax":-1324.0,"yMax":-549.0},"title":"Correct
      way to check if my AI has card in hand AND add them to possibleCards list","body":"\n1)
      Go trough my Cards In Hand (Game Objects) with For Each loop\n\n2) Get the
      Card Display component (from my Game Objects, I make a reference to the Card
      Display component which contains my Scriptable Objects)\n\n3) Get the Card
      Data component (the Card Data component is what it makes me possible to make
      a reference to my Scripting Objects from my GameObjects)\n\n4) Get Card Name
      (refers to my Scriptable Objects)\n-> This one is tricky : My Card Data component
      contains which specific Card is attached to it\nSo I can get my cards data
      (value, name, color, ...) from my Card Display component \n\n5) Connect my
      Get Card Data component to the Add Item node because it''s the direct reference
      from my Scriptable Objects\n \n","colorTheme":"Classic","guid":"ce9ecae0-c65d-4a24-af16-d82853201a98","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-2698.0,"yMin":-875.0,"xMax":-2453.0,"yMax":-778.0},"title":"Clear
      list ","body":"\nMake sure that there are NOT multiple time the same card stored
      in possibleCards list\n","colorTheme":"Classic","guid":"7f6cb8d4-9c4a-42bf-9a9a-84a6a2029bdc","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":5915.0,"yMin":-1187.0,"xMax":6249.0,"yMax":-1000.0},"title":"Second
      For Each Loop","body":"\nI cannot use ScriptableOjects (from possibleCards)
      directly to make the AI plays its card \n-> it''s NOT GAMEOBJECTS\n\nInstead,
      the second For Each Loop is used to check if some cards displayed in the AI''s
      hand match the Card Data stored in the possibleCards list \n\n\n","colorTheme":"Classic","guid":"81833bac-ef53-4d21-ae9b-1e49b9dd2f68","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}},"defaultValues":{},"position":{"x":833.0,"y":270.0},"guid":"d6acf602-e108-42dd-b5ee-0d2388fa72eb","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"24"},{"type":"System.Int32","value":{"$content":2,"$type":"System.Int32"},"defaultValues":{},"position":{"x":820.0,"y":-394.0},"guid":"389bdd21-8e53-4265-8d80-54cf56560751","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"627"},{"numeric":false,"defaultValues":{},"position":{"x":431.0,"y":350.0},"guid":"697d8510-7727-4fbf-9b08-04ee07d3aae5","$version":"A","$type":"Unity.VisualScripting.Equal","$id":"629"},{"argumentCount":0,"coroutine":false,"defaultValues":{"target":null,"name":{"$content":"NextTurn","$type":"System.String"}},"position":{"x":-148.0,"y":-683.0},"guid":"9826034e-fcb6-42aa-b1b2-d16e6e15ccc1","$version":"A","$type":"Unity.VisualScripting.CustomEvent","$id":"631"},{"defaultValues":{},"position":{"x":583.0,"y":271.0},"guid":"292374a0-066a-4322-ba68-cf3f455d1f68","$version":"A","$type":"Unity.VisualScripting.If","$id":"633"},{"chainable":false,"parameterNames":["name"],"member":{"name":"Find","parameterTypes":["System.String"],"targetType":"UnityEngine.GameObject","targetTypeName":"UnityEngine.GameObject","$version":"A"},"defaultValues":{"%name":{"$content":"PlayerAI2","$type":"System.String"}},"position":{"x":881.0,"y":740.0},"guid":"2e35bac8-a6fd-4177-adf2-474e0021a6f1","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"635"},{"type":"System.Int32","value":{"$content":0,"$type":"System.Int32"},"defaultValues":{},"position":{"x":-197.0,"y":314.0},"guid":"e830ef63-a1a7-4deb-9037-a985d658bd4c","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"639"},{"nest":{"source":"Embed","macro":null,"embed":{"variables":{"Kind":"Flow","collection":{"$content":[],"$ver