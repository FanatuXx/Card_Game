      DO !","body":"\nPLAYER SPECIFIC :\n\n- SET CARDS BY COLOR AFTER DEALING CARDS\n-
      SET CARDS COUNT BY COLOR AFTER DEALING CARDS\n\nSHARED INBETWEEN PLAYERS :\n\n-
      When a card is played this round, ADD IT TO PLAYEDCARDSTHISROUND\n- When a
      card is played, ADD IT TO ALLPLAYEDCARDS\n- When a card is played, ADD IT TO
      CURRENTTRICKPLAYERCARDS with reference to the PLAYER\n- When a player is out
      of cards from a specific color, ADD A REFERENCE TO THIS COLOR TO PLAYERSWHOHAVECUT\n-
      When a card is played, REMOVE ITS COLOR FROM UNPLAYEDCOLOR\n- When a card is
      played, DECREMENT ITS COLOR''S VALUE FROM STRONGESTREMAININGCARDBYCOLOR\n\n\n\n","colorTheme":"Classic","guid":"807bba9d-73c0-4f2d-a558-d37316c1ad90","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}},"defaultValues":{},"position":{"x":833.0,"y":269.0},"guid":"d6acf602-e108-42dd-b5ee-0d2388fa72eb","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"24"},{"kind":"Object","defaultValues":{"name":{"$content":"PlayerAI1","$type":"System.String"},"object":null},"position":{"x":676.0,"y":738.0},"guid":"eb0bcc17-bf7a-4981-bd68-0624664b3c2c","$version":"A","$type":"Unity.VisualScripting.SetVariable","$id":"1554"},{"defaultValues":{},"position":{"x":-161.0,"y":-422.0},"guid":"655c28e4-59e4-45a0-a729-09aa001f973a","$version":"A","$type":"Unity.VisualScripting.If","$id":"1556"},{"kind":"Object","defaultValues":{"name":{"$content":"CurrentPlayer","$type":"System.String"},"object":null},"position":{"x":-78.0,"y":-631.0},"guid":"e19607a4-237e-40c3-8218-9cf9d6c72042","$version":"A","$type":"Unity.VisualScripting.SetVariable","$id":"1558"},{"nest":{"source":"Embed","macro":null,"embed":{"variables":{"Kind":"Flow","collection":{"$content":[],"$version":"A"},"$version":"A"},"controlInputDefinitions":[{"key":"In","label":"In","summary":null,"hideLabel":false}],"controlOutputDefinitions":[{"key":"Out","label":"Out","summary":null,"hideLabel":false}],"valueInputDefinitions":[],"valueOutputDefinitions":[],"title":"PlayerHuman","summary":null,"pan":{"x":-416.548,"y":-13.0},"zoom":1.0,"elements":[{"defaultValues":{},"position":{"x":-858.0,"y":-21.0},"guid":"076136f3-de80-432a-8a55-ca3fbb8c7aa4","$version":"A","$type":"Unity.VisualScripting.GraphInput","$id":"1572"},{"defaultValues":{},"position":{"x":-281.0,"y":-22.0},"guid":"6b1359c2-142d-4d6b-b986-9082ab324ce7","$version":"A","$type":"Unity.VisualScripting.GraphOutput","$id":"1574"},{"nest":{"source":"Embed","macro":null,"embed":{"variables":{"Kind":"Flow","collection":{"$content":[],"$version":"A"},"$vers