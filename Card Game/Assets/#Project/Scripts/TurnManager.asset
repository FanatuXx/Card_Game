ion"},{"sourceUnit":{"$ref":"4496"},"sourceKey":"value","destinationUnit":{"$ref":"4472"},"destinationKey":"b","guid":"109814d6-1fab-4e74-9a5f-9dff1539d262","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"4451"},"sourceKey":"out","destinationUnit":{"$ref":"4455"},"destinationKey":"in","guid":"51af8b3d-e398-41d7-9c70-fe9aa758d8a7","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"4479"},"sourceKey":"value","destinationUnit":{"$ref":"4484"},"destinationKey":"a","guid":"785c7e9c-7740-4d09-9392-7e843203a08a","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"4460"},"sourceKey":"equal","destinationUnit":{"$ref":"4494"},"destinationKey":"b","guid":"d1ef7f7c-c496-4a6e-8ffc-25a7c5272cf2","$type":"Unity.VisualScripting.ValueConnection"},{"position":{"xMin":-1814.0,"yMin":394.0,"xMax":-1100.0,"yMax":700.0},"title":"Correct
      way to check if my AI has card in hand AND add them to possibleCards list","body":"\n1)
      Go trough my Cards In Hand (Game Objects) with For Each loop\n\n2) Get the
      Card Display component (from my Game Objects, I make a reference to the Card
      Display component which contains my Scriptable Objects)\n\n3) Get the Card
      Data component (the Card Data component is what it makes me possible to make
      a reference to my Scripting Objects from my GameObjects)\n\n4) Get Card Name
      (refers to my Scriptable Objects)\n-> This one is tricky : My Card Data component
      contains which specific Card is attached to it\nSo I can get my cards data
      (value, name, color, ...) from my Card Display component \n\n5) Connect my
      Get Card Data component to the Add Item node because it''s the direct reference
      from my Scriptable Objects\n \n","colorTheme":"Classic","guid":"29615cf0-4d2c-4278-8bbe-fafd63685f20","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}},"defaultValues":{},"position":{"x":2981.0,"y":-826.0},"guid":"5a61090f-7c7e-464e-b3ec-3b95efcc3a7d","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"4435"},{"SnapToGrid":false,"defaultValues":{},"position":{"x":14192.0,"y":-778.0},"guid":"1edd8d52-7150-4bb3-a516-3fb72bf1bd89","$version":"A","$type":"Unity.VisualScripting.Community.FlowReroute","$id":"4529"},{"portType":"System.Object","SnapToGrid":false,"defaultValues":{},"position":{"x":5662.0,"y":-492.0},"guid":"76280a2a-9c62-4906-9653-9b4617cfd5dc","$version":"A","$type":"Unity.VisualScripting.Community.ValueReroute","$id":"4531"},{"specifyFallback":false,"kind":"Scene","defaultValues":{"name":{"$content":"playedCardsThisRound","$type":"System.String"}},"position":{"x":1336.0,"y":203.0},"guid":"c321c286-443e-4185-8c10-5b406d1b0304","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"4533"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"possibleCards","$type":"System.String"}},"position":{"x":6414.0,"y":293.0},"guid":"1ef91551-548e-418f-8dbb-a595026e050c","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"4535"},{"kind":"Graph","defaultValues":{"name":{"$content":"cardsMinValue","$type":"System.String"}},"position":{"x":11315.0,"y":-1598.0},"guid":"800d5beb-60e8-485f-ad57-7e33799d0e63","$version":"A","$type":"Unity.VisualScripting.SetVariable","$id":"4537"},{"specifyFallback":false,"kind":"Graph","defaultValues":{"name":{"$content":"possibleCards","$type":"System.String"}},"position":{"x":6068.0,"y":1450.0},"guid":"edad0421-c0f8-43b5-b3c7-58e782e68290","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"4539"},{"nest":{"source":"Embed","macro":null,"embed":{"variables":{"Kind":"Flow","collection":{"$content":[{"name":"cardToPlay","value":null,"typeHandle":{"