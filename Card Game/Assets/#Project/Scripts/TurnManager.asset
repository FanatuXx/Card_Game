urceUnit":{"$ref":"1207"},"sourceKey":"possibleCards","destinationUnit":{"$ref":"1239"},"destinationKey":"in","guid":"38afa56d-9bfc-4c7d-8c93-f915994bcf51","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"1209"},"sourceKey":"equal","destinationUnit":{"$ref":"1226"},"destinationKey":"b","guid":"d1ef7f7c-c496-4a6e-8ffc-25a7c5272cf2","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"1232"},"sourceKey":"value","destinationUnit":{"$ref":"1251"},"destinationKey":"b","guid":"28688389-95e8-4a91-92be-d662fa3b6954","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"1243"},"sourceKey":"value","destinationUnit":{"$ref":"1209"},"destinationKey":"b","guid":"2e968f62-bcac-4ca8-840e-11d6450c0edf","$type":"Unity.VisualScripting.ValueConnection"},{"position":{"xMin":-1814.0,"yMin":394.0,"xMax":-1100.0,"yMax":700.0},"title":"Correct
      way to check if my AI has card in hand AND add them to possibleCards list","body":"\n1)
      Go trough my Cards In Hand (Game Objects) with For Each loop\n\n2) Get the
      Card Display component (from my Game Objects, I make a reference to the Card
      Display component which contains my Scriptable Objects)\n\n3) Get the Card
      Data component (the Card Data component is what it makes me possible to make
      a reference to my Scripting Objects from my GameObjects)\n\n4) Get Card Name
      (refers to my Scriptable Objects)\n-> This one is tricky : My Card Data component
      contains which specific Card is attached to it\nSo I can get my cards data
      (value, name, color, ...) from my Card Display component \n\n5) Connect my
      Get Card Data component to the Add Item node because it''s the direct reference
      from my Scriptable Objects\n \n","colorTheme":"Classic","guid":"29615cf0-4d2c-4278-8bbe-fafd63685f20","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}},"defaultValues":{},"position":{"x":2981.0,"y":-826.0},"guid":"5a61090f-7c7e-464e-b3ec-3b95efcc3a7d","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"1193"},{"type":"System.Int32","value":{"$content":3,"$type":"System.Int32"},"defaultValues":{},"position":{"x":14547.0,"y":285.0},"guid":"5f00f01b-9358-4b1f-958d-5dfd26a33a85","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"1287"},{"numeric":true,"defaultValues":{"b":{"$content":0.0,"$type":"System.Single"}},"position":{"x":620.0,"y":167.0},"guid":"d2d70471-fc5b-400b-a338-6a9022146bbf","$version":"A","$type":"Unity.VisualScripting.Greater","$id":"1289"},{"chainable":false,"parameterNames":["message"],"member":{"name":"Log","parameterTypes":["System.Object"],"targetType":"UnityEngine.Debug","targetTypeName":"UnityEngine.Debug","$version":"A"},"defaultValues":{},"position":{"x":4762.0,"y":-854.0},"guid":"0b924dd3-6019-4206-aaa9-f9b8c8bf6538","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"1291"},{"specifyFallback":false,"kind":"Scene","defaultValues":{"name":{"$content":"leadingColor","$type":"System.String"}},"position":{"x":6998.0,"y":465.0},"guid":"0855c509-f6b1-47e9-b7fc-3d03194ada4a","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"1295"},{"kind":"Graph","defaultValues":{"name":{"$content":"aiLogicHasRun","$type":"System.String"}},"position":{"x":15934.0,"y":215.0},"guid":"a0411eb8-fa62-4975-a576-c4a960a7511b","$version":"A","$type":"Unity.VisualScripting.SetVariable","$id":"1297"},{"type":"System.Boolean","value":{"$content":false,"$type":"System.Boolean"},"defaultValues":{},"position":{"x":15788.0,"y":312.0},"guid":"29dd0a30-c667-471b-b402-90423cdf8cac","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"1299"},{"SnapToGrid":false,"defaultValues":{},"position":{"x":1259.0